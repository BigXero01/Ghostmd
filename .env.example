# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-refresh-secret-min-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# Social sign-in (Google / Apple)
# API verifies provider identity tokens against these audiences.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
APPLE_CLIENT_ID=com.ghostmd.web
# Web client SDKs (must be exposed to the browser, hence NEXT_PUBLIC_).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
NEXT_PUBLIC_APPLE_CLIENT_ID=com.ghostmd.web

# Database
DATABASE_URL=postgresql://ghostmd:password@localhost:5432/ghostmd

# Redis
REDIS_URL=redis://localhost:6379

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Exchange APIs
BINANCE_API_KEY=
BINANCE_SECRET=
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=

# Monitoring
DATADOG_API_KEY=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# AWS
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
